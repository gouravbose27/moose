// Lark grammar for moose: terminals + rules per docs/PLAN.md grammar sketch (Phase 1).
// Left-recursive + aliased rules (not repeated-operator groups): Lark's LALR parser wants
// left recursion, and anonymous string-literal tokens (keywords, operators, punctuation) are
// elided from the tree, so each alternative needs its own alias for ast_builder.py to tell
// operators apart. `block`/`params`/`arguments` are always-wrapped (non-"?") sub-rules so
// their statement/name/expression lists don't flatten into their parent's children.

?start: block

block: _NEWLINE* (statement _NEWLINE*)*

?statement: if_stmt | func_def | return_stmt | assignment | expr_stmt

if_stmt: "if" expression ":" block ("else" ":" block)? "end"
func_def: "def" NAME "(" params ")" ":" block "end"
params: (NAME ("," NAME)*)?
return_stmt: "return" expression?
assignment: "let" NAME "=" expression
expr_stmt: expression

?expression: or_expr

?or_expr: and_expr
        | or_expr "or" and_expr     -> or_

?and_expr: not_expr
         | and_expr "and" not_expr  -> and_

?not_expr: comparison
         | "not" not_expr           -> not_

?comparison: term
           | comparison "==" term   -> eq
           | comparison "!=" term   -> ne
           | comparison "<" term    -> lt
           | comparison ">" term    -> gt
           | comparison "<=" term   -> le
           | comparison ">=" term   -> ge

?term: factor
     | term "+" factor -> add
     | term "-" factor -> sub

?factor: unary
       | factor "*" unary -> mul
       | factor "/" unary -> div
       | factor "%" unary -> mod

?unary: call
      | "-" unary -> neg

?call: primary
     | call "(" arguments ")" -> call

arguments: (expression ("," expression)*)?

?primary: NUMBER            -> number
        | "true"            -> true
        | "false"           -> false
        | NAME              -> variable
        | "(" expression ")"

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER: /\d+(\.\d+)?/
_NEWLINE: /(\r?\n)+/
COMMENT: /#[^\n]*/
%ignore /[ \t]+/
%ignore COMMENT
